  "room": {"hex": "#1B1720", "use": "Base background: a dim, plum-tinted screening room"},
  "seat": {"hex": "#25202C", "use": "Raised surfaces: panels, menus, inputs"},
  "seatRaised": {"hex": "#2E2836", "use": "A surface on a surface: a menu over a panel"},
  "aisle": {"hex": "#3A3343", "use": "Hairlines and inactive controls"},
  "screen": {"hex": "#F2EEE7", "use": "Primary text: warm projected white"},
  "usher": {"hex": "#A39AAE", "use": "Secondary text"},
  "silver": {"hex": "#A9C2EC", "use": "Fallback accent when a title has no ambient colour"},
  "go": {"hex": "#7FD1A0", "use": "Connected, on, set up, downloaded, in the library"},
  "danger": {"hex": "#F08A7E", "use": "Destructive actions and error messages, never decoration"},
  "record": {"hex": "#E5484D", "use": "The live and recording dot on Live TV, nothing else"},
  "well": {"hex": "#141118", "use": "Inside text fields and menus, below the panel"}
