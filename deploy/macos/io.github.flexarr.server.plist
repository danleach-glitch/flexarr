<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Installed to ~/Library/LaunchAgents by scripts/deploy-macos.sh; __ROOT__ and __DOTNET__ are replaced at install time.
  Flexarr runs under Microsoft's signed `dotnet` host rather than its own apphost: macOS privacy (TCC) grants such as
  access to external drives are tied to the executable's signature, and the host's stays the same across deploys.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.flexarr.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DOTNET__</string>
    <string>__ROOT__/app/Flexarr.dll</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__/app</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DOTNET_ROOT</key>
    <string>__DOTNET_ROOT__</string>
    <key>ASPNETCORE_ENVIRONMENT</key>
    <string>Production</string>
    <key>Flexarr__DataDirectory</key>
    <string>__ROOT__/data</string>
    <!-- Flexarr writes its own daily log files here (Settings › Logs reads them) and trims them itself. -->
    <key>Flexarr__Logs__Directory</key>
    <string>__ROOT__/logs</string>
    <!-- Nothing trims launchd's copy of standard output, so only warnings and errors go there. -->
    <key>Flexarr__Logs__ConsoleLevel</key>
    <string>Warning</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__ROOT__/logs/console.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/console.log</string>
</dict>
</plist>
