<?xml version="1.0" encoding="utf-8"?>
<!-- Up Next on the home screen (PodcastWidgets): four cells by two, three episodes, or two by two with the first. It asks
     the server again every hour, and whenever the app changes Up Next or plays an episode. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_up_next_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewImage="@drawable/widget_up_next_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen" />
