{
 "about": "Every platform's message formatter runs these (scripts/i18n, frontend/src/i18n, FlexarrKit, Android core, Flexarr.Core). 'expect' is the formatted text; 'error' means the message is refused (the lookup then shows the English). A missing value prints as {name}. Numbers stay under 1,000 except where grouping is the point.",
 "format": [
  {"locale": "en", "message": "Mark as watched", "args": {}, "expect": "Mark as watched"},
  {"locale": "en", "message": "Resume from {time}", "args": {"time": "32:10"}, "expect": "Resume from 32:10"},
  {"locale": "en", "message": "{a} and {b}, then {a}", "args": {"a": "x", "b": "y"}, "expect": "x and y, then x"},
  {"locale": "en", "message": "Hello {name}", "args": {}, "expect": "Hello {name}"},
  {"locale": "en", "message": "Don't stop", "args": {}, "expect": "Don't stop"},
  {"locale": "en", "message": "It''s '{'literal'}'", "args": {}, "expect": "It's {literal}"},
  {"locale": "en", "message": "Use '#' here", "args": {}, "expect": "Use '#' here"},
  {"locale": "en", "message": "{n, plural, one {# season} other {# seasons}}", "args": {"n": 1}, "expect": "1 season"},
  {"locale": "en", "message": "{n, plural, one {# season} other {# seasons}}", "args": {"n": 0}, "expect": "0 seasons"},
  {"locale": "en", "message": "{n, plural, one {# season} other {# seasons}}", "args": {"n": 12}, "expect": "12 seasons"},
  {"locale": "en", "message": "{n, plural, =0 {No episodes} one {# episode} other {# episodes}}", "args": {"n": 0}, "expect": "No episodes"},
  {"locale": "en", "message": "{n, plural, =1 {Just one} one {# thing} other {# things}}", "args": {"n": 1}, "expect": "Just one"},
  {"locale": "en", "message": "{n, plural, one {'#' {n}} other {# '#'}}", "args": {"n": 1}, "expect": "# 1"},
  {"locale": "en", "message": "{n, plural, one {# item} other {# items}}", "args": {"n": 1.5}, "expect": "1.5 items"},
  {"locale": "en", "message": "{n, number} plays", "args": {"n": 1234}, "expect": "1,234 plays", "grouping": true},
  {"locale": "de", "message": "{n, number} Wiedergaben", "args": {"n": 1234}, "expect": "1.234 Wiedergaben", "grouping": true},
  {"locale": "de", "message": "{n, plural, one {# Element} other {# Elemente}}", "args": {"n": 1.5}, "expect": "1,5 Elemente", "grouping": true},
  {"locale": "pl", "message": "{n, plural, one {# sezon} few {# sezony} many {# sezonów} other {# sezonu}}", "args": {"n": 1}, "expect": "1 sezon"},
  {"locale": "pl", "message": "{n, plural, one {# sezon} few {# sezony} many {# sezonów} other {# sezonu}}", "args": {"n": 3}, "expect": "3 sezony"},
  {"locale": "pl", "message": "{n, plural, one {# sezon} few {# sezony} many {# sezonów} other {# sezonu}}", "args": {"n": 5}, "expect": "5 sezonów"},
  {"locale": "pl", "message": "{n, plural, one {# sezon} few {# sezony} many {# sezonów} other {# sezonu}}", "args": {"n": 22}, "expect": "22 sezony"},
  {"locale": "ar", "message": "{n, plural, zero {z} one {o} two {t} few {f} many {m} other {x}}", "args": {"n": 0}, "expect": "z"},
  {"locale": "ar", "message": "{n, plural, zero {z} one {o} two {t} few {f} many {m} other {x}}", "args": {"n": 2}, "expect": "t"},
  {"locale": "ar", "message": "{n, plural, zero {z} one {o} two {t} few {f} many {m} other {x}}", "args": {"n": 105}, "expect": "f"},
  {"locale": "ar", "message": "{n, plural, zero {z} one {o} two {t} few {f} many {m} other {x}}", "args": {"n": 11}, "expect": "m"},
  {"locale": "ar", "message": "{n, plural, zero {z} one {o} two {t} few {f} many {m} other {x}}", "args": {"n": 100}, "expect": "x"},
  {"locale": "ja", "message": "{n, plural, other {#件}}", "args": {"n": 1}, "expect": "1件"},
  {"locale": "fr", "message": "{n, plural, one {# épisode} many {# d’épisodes} other {# épisodes}}", "args": {"n": 0}, "expect": "0 épisode"},
  {"locale": "pt-PT", "message": "{n, plural, one {# um} other {# outros}}", "args": {"n": 0}, "expect": "0 outros"},
  {"locale": "pt", "message": "{n, plural, one {# um} other {# outros}}", "args": {"n": 0}, "expect": "0 um"},
  {"locale": "en", "message": "{kind, select, album {Album} single {Single} other {Release}}", "args": {"kind": "single"}, "expect": "Single"},
  {"locale": "en", "message": "{kind, select, album {Album} single {Single} other {Release}}", "args": {"kind": "ep"}, "expect": "Release"},
  {"locale": "en", "message": "{kind, select, album {{n, plural, one {# album} other {# albums}}} other {{n, plural, one {# track} other {# tracks}}}}", "args": {"kind": "album", "n": 2}, "expect": "2 albums"},
  {"locale": "en", "message": "{who} added {n, plural, one {# film} other {# films}} to {library}", "args": {"who": "Sam", "n": 3, "library": "Movies"}, "expect": "Sam added 3 films to Movies"}
 ],
 "errors": [
  "{",
  "}",
  "Unclosed {name",
  "{n, plural, one {# x}}",
  "{n, date}",
  "{1}",
  "{k, select, =1 {x} other {y}}",
  "{n, plural, one {a} one {b} other {c}}",
  "It'{s broken"
 ]
}
