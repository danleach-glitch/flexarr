<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Flexarr</AssemblyName>
    <RootNamespace>Flexarr.Api</RootNamespace>
    <!-- The API's endpoint handlers are written at build time, not compiled from expressions each time a server
         starts: starting is quicker, and test servers no longer queue on the runtime's code-generation lock. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <!-- RDG004: the few endpoints answering with an anonymous type are left to be built at runtime, as before. -->
    <NoWarn>$(NoWarn);RDG004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Expressions" />
    <PackageReference Include="Sentry" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shown in Settings › About, so it always matches the version that's running. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <!-- Run by Settings › Updates on a Mac to put a release in place (Updates/MacUpdater.cs). -->
    <EmbeddedResource Include="Updates/install-update.sh" LogicalName="install-update.sh" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Flexarr.Api.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Flexarr.Core\Flexarr.Core.csproj" />
    <ProjectReference Include="..\Flexarr.Integrations.Arr\Flexarr.Integrations.Arr.csproj" />
    <ProjectReference Include="..\Flexarr.Metadata\Flexarr.Metadata.csproj" />
    <ProjectReference Include="..\Flexarr.Streaming\Flexarr.Streaming.csproj" />
  </ItemGroup>
</Project>
